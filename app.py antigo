@app.get("/alunos", response_class=HTMLResponse)
async def listar_alunos():
    conexao = sqlite3.connect("alunos.db")
    cursor = conexao.cursor()

    cursor.execute("""
        SELECT id, nome, turma, bimestre, arquivo, data_envio, nota, acertos, situacao, compensacao
        FROM envios
    """)

    alunos = cursor.fetchall()
    conexao.close()

    html = """
    <h1>Alunos Cadastrados</h1>

    <table border='1' cellpadding='8'>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Turma</th>
            <th>Bimestre</th>
            <th>Arquivo</th>
            <th>Data</th>
            <th>Nota</th>
            <th>Acertos</th>
            <th>Situação</th>
            <th>Compensação</th>
            <th>Foto</th>
            <th>Corrigir</th>
        </tr>
    """

    for aluno in alunos:
        nota = aluno[6] if aluno[6] is not None else "-"
        acertos = aluno[7] if aluno[7] is not None else "-"
        situacao = aluno[8] if aluno[8] is not None else "-"
        compensacao = aluno[9] if aluno[9] is not None else "-"

        html += f"""
        <tr>
            <td>{aluno[0]}</td>
            <td>{aluno[1]}</td>
            <td>{aluno[2]}</td>
            <td>{aluno[3]}</td>
            <td>{aluno[4]}</td>
            <td>{aluno[5]}</td>
            <td>{nota}</td>
            <td>{acertos}</td>
            <td>{situacao}</td>
            <td>{compensacao}</td>
            <td>
                <a href="/uploads/{aluno[4]}" target="_blank">Abrir Foto</a>
            </td>
            <td>
                <a href="/corrigir?aluno_id={aluno[0]}">Corrigir</a>
            </td>
        </tr>
        """

    html += """
    </table>

    <br><br>
    <a href="/">Página Inicial</a>
    """

    return HTMLResponse(html)


