# ==========================
# SALVAR ENVIO
# ==========================

@app.post("/upload")
async def upload_file(
    nome: str = Form(...),
    turma: str = Form(...),
    bimestre: str = Form(...),
    arquivo: UploadFile = File(...)
):
    caminho = f"uploads/{arquivo.filename}"

    with open(caminho, "wb") as buffer:
        shutil.copyfileobj(arquivo.file, buffer)

    data_envio = datetime.now().strftime("%d/%m/%Y %H:%M:%S")

    conexao = sqlite3.connect("alunos.db")
    cursor = conexao.cursor()

    cursor.execute("""
        INSERT INTO envios
        (nome, turma, bimestre, arquivo, data_envio)
        VALUES (?, ?, ?, ?, ?)
    """, (nome, turma, bimestre, arquivo.filename, data_envio))

    conexao.commit()
    conexao.close()

    return HTMLResponse(f"""
        <h2>Atividade enviada com sucesso!</h2>

        <p><b>Aluno:</b> {nome}</p>
        <p><b>Turma:</b> {turma}</p>
        <p><b>Bimestre:</b> {bimestre}</p>
        <p><b>Arquivo:</b> {arquivo.filename}</p>

        <br>
        <a href="/upload">Enviar outra atividade</a><br>
        <a href="/alunos">Ver alunos cadastrados</a>
    """)


