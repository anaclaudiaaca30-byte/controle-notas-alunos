        <label>Resposta Questão 3:</label><br>
        <input type="text" name="q3"><br><br>

        <label>Resposta Questão 4:</label><br>
        <input type="text" name="q4"><br><br>

        <label>Resposta Questão 5:</label><br>
        <input type="text" name="q5"><br><br>

        <button type="submit">Corrigir</button>
    </form>

    <br>
    <a href="/alunos">Ver alunos</a><br>
    <a href="/">Voltar</a>
    """


@app.post("/corrigir")
async def corrigir(
    aluno_id: int = Form(...),
    q1: str = Form(""),
    q2: str = Form(""),
    q3: str = Form(""),
    q4: str = Form(""),
    q5: str = Form("")
):
    conexao = sqlite3.connect("alunos.db")
    cursor = conexao.cursor()

    cursor.execute("""
        SELECT q1, q2, q3, q4, q5
        FROM gabarito
        ORDER BY id DESC
        LIMIT 1
    """)

    gabarito = cursor.fetchone()

    if gabarito is None:
        conexao.close()
        return HTMLResponse("""
        <h2>Você ainda não cadastrou um gabarito.</h2>
        <a href="/gabarito">Cadastrar gabarito</a>
        """)

    respostas = [q1, q2, q3, q4, q5]
    acertos = 0

    for resposta, correta in zip(respostas, gabarito):
        if resposta.strip().lower() == correta.strip().lower():
            acertos += 1

    nota = round((acertos / 5) * 10, 2)

    if nota >= 6:
        situacao = "APROVADO"
        compensacao = "NÃO"
    else:
        situacao = "RECUPERAÇÃO"
        compensacao = "SIM"

    cursor.execute("""
        UPDATE envios
        SET nota = ?, situacao = ?, compensacao = ?, acertos = ?
        WHERE id = ?
    """, (nota, situacao, compensacao, acertos, aluno_id))

    conexao.commit()
    conexao.close()

    return HTMLResponse(f"""
    <h1>Resultado da Correção</h1>

    <p><b>ID do aluno:</b> {aluno_id}</p>
    <p><b>Acertos:</b> {acertos}/5</p>
    <p><b>Nota:</b> {nota}</p>
    <p><b>Situação:</b> {situacao}</p>
    <p><b>Compensação:</b> {compensacao}</p>

    <br>
    <a href="/corrigir">Corrigir outro aluno</a><br>
    <a href="/alunos">Ver alunos cadastrados</a>
    """)