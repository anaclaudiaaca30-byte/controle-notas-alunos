# BANCO DE DADOS
# ==========================

def criar_banco():
    conexao = sqlite3.connect("alunos.db")
    cursor = conexao.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS envios (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT,
            turma TEXT,
            bimestre TEXT,
            arquivo TEXT,
            data_envio TEXT,
            nota REAL,
            situacao TEXT,
            compensacao TEXT,
            acertos INTEGER
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS gabarito (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            q1 TEXT,
            q2 TEXT,
            q3 TEXT,
            q4 TEXT,
            q5 TEXT,
            data_cadastro TEXT
        )
    """)

    conexao.commit()
    conexao.close()


criar_banco()


